{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:studio": "pnpm --filter studio dev",
    "build": "pnpm -r --filter ./apps/* build",
    "build:web": "pnpm --filter web build",
    "build:studio": "pnpm --filter studio build"
  },
  "devDependencies": {
    "turbo": "^1.10.0"
  },
  "pnpm": {
    "overrides": {
      "vite": "^6.0.0"
    }
  }
}