{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:studio": "pnpm --filter studio dev",
    "build": "pnpm -r --filter ./apps/* build",
    "build:web": "pnpm --filter web build",
    "build:studio": "pnpm --filter studio build",
    "lh:collect": "lhci collect --config=./lighthouserc.json",
    "lh:assert": "lhci assert --config=./lighthouserc.json",
    "lh:ci": "pnpm run build:web && lhci autorun --config=./lighthouserc.json"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "turbo": "^1.10.0"
  }
}