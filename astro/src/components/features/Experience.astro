---
import Stepper from "../ui/Stepper.astro";
import SkeletonList from "../ui/SkeletonList.astro";
import { calculateTenure, formatDateRange } from "@/utils";

interface StepperItem {
  id?: string;
  joiningDate?: string;
  releaseDate?: string;
  designation?: string;
  company?: string;
  roles?: string[];
  desc?: string;
  link: string;
  heading: string;
}

interface Props {
  data: StepperItem[];
  isLoading?: boolean;
  isMobile?: boolean;
}

const { data, isLoading = false, isMobile = false } = Astro.props as Props;

// map data to include tenure and formatted date range
const mappedData = data.map((item) => ({
  ...item,
  tenure: calculateTenure(item.joiningDate ?? "", item.releaseDate ?? ""),
  dateRange: formatDateRange(item.joiningDate ?? "", item.releaseDate ?? ""),
}));
---

<div class="mt-4 mr-0 mb-0 sm:ml-6 pt-1 grid gap-4">
  {
    isLoading ? (
      <SkeletonList />
    ) : (
      mappedData.map((item, index) => (
        <Stepper
          isMobile={isMobile}
          hasLine={index < mappedData.length - 1}
          index={index}
          stepperIndex={item.tenure}
          heading={item.designation ?? ""}
          extraHeading={item.company}
          subHeading={item.dateRange}
          desc={item.desc}
          link={item.link}
          list={item.roles}
        />
      ))
    )
  }
</div>

<style>
  /* staggered fade-in + translate for each stepper item */
  :root {
    --stagger-delay: 0.1s;
  }

  div > :is(.stepper-item, .flex) {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.5s forwards;
  }

  div > :is(.stepper-item, .flex):nth-child(1) {
    animation-delay: calc(var(--stagger-delay) * 0);
  }
  div > :is(.stepper-item, .flex):nth-child(2) {
    animation-delay: calc(var(--stagger-delay) * 1);
  }
  div > :is(.stepper-item, .flex):nth-child(3) {
    animation-delay: calc(var(--stagger-delay) * 2);
  }
  /* add more nth-child rules if needed */

  @keyframes fadeInUp {
    0% {
      opacity: 0;
      transform: translateY(20px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
