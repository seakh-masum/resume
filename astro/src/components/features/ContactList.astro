---
import { urlFor } from "@/lib/image";

interface Contact {
  url: string;
  image: any;
  value: string;
}

interface Props {
  data: Contact[];
  isLoading: boolean;
}

const { data, isLoading } = Astro.props;
---

<style>
  @keyframes fadeInUp {
    0% {
      opacity: 0;
      transform: translateY(20px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fadeInUp {
    animation: fadeInUp 0.4s ease-out forwards;
  }
</style>

<div class="p-6 pt-2 flex flex-col sm:flex-row gap-3 justify-evenly">
  {
    data.map((item, index) => (
      <a
        href={item.url}
        class="flex flex-row gap-2 items-center transition-transform duration-200 hover:scale-105 active:scale-95"
        style={`animation-delay: ${index * 0.15}s;`}
      >
        {isLoading ? (
          <>
            <div class="rounded-full w-12 h-12 bg-surface animate-pulse" />
            <div class="bg-surface h-10 rounded-xl w-full sm:w-32 animate-pulse" />
          </>
        ) : (
          <>
            <div
              class="bg-secondary rounded-full p-3 animate-fadeInUp"
              style={`animation-delay: ${index * 0.15 + 0.1}s;`}
            >
              <img
                src={urlFor(item.image).width(24).height(24).url()}
                width={24}
                height={24}
                alt="contact-icon"
                class="w-6 h-6"
                loading="lazy"
              />
            </div>
            <p
              class="leading-12 text-lg dark:text-text animate-fadeInUp"
              style={`animation-delay: ${index * 0.15 + 0.2}s;`}
            >
              {item.value}
            </p>
          </>
        )}
      </a>
    ))
  }
</div>
