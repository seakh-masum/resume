---
interface Props {
  size?: "lg" | "sm";
  hasStroke?: boolean;
  class?: string;
  stroke?: string;
  style?: string;
}

const {
  size = "sm",
  hasStroke = false,
  class: className = "",
  stroke,
  style,
} = Astro.props;

const offset = size === "lg" ? 125 : 50;
const radius = size === "lg" ? 110 : 40;
const dasharray = 625;
---

<circle
  cx={offset}
  cy={offset}
  r={radius}
  stroke-linecap="round"
  stroke-width="10"
  class={className}
  style={style}
  {...hasStroke ? { "stroke-dasharray": dasharray } : {}}
  {...stroke ? { stroke } : {}}></circle>

<style>
  .circle-svg {
    transform: rotate(-90deg);
  }

  .circle-bg {
    fill: none;
    stroke: var(--color-surface, #2a2a2a);
    stroke-width: 10;
  }

  .circle-progress {
    fill: none;
    /* stroke: var(--color-accent, #7c7cff); */
    stroke-width: 10;
    stroke-linecap: round;
    stroke-dasharray: var(--circumference);
    stroke-dashoffset: var(--circumference);
    animation: draw-circle 1.2s ease-out forwards;
  }

  @keyframes draw-circle {
    to {
      stroke-dashoffset: var(--offset);
    }
  }
</style>
