---
import CloseIcon from "../icons/CloseIcon.astro";

interface Props {
  id: string;
}
const { id } = Astro.props;
---

<dialog
  id={id}
  class="modal fixed inset-0 z-50 m-0 h-screen w-screen max-h-none max-w-none"
  onclose="document.body.classList.remove('overflow-hidden')"
  oncancel="document.body.classList.remove('overflow-hidden')"
>
  <!-- Backdrop -->
  <form method="dialog" class="modal-backdrop absolute inset-0"></form>

  <!-- Modal content -->
  <div
    class="modal-content bg-accent shadow-xl"
    data-sheet
    onclick="event.stopPropagation()"
  >
    <!-- Sticky header -->
    <div class="modal-header">
      <!-- Drag handle (mobile) -->
      <div class="sheet-handle"></div>

      <!-- Close -->
      <form method="dialog">
        <button class="modal-close" aria-label="Close">
          <CloseIcon />
        </button>
      </form>
    </div>

    <!-- Scrollable body -->
    <div class="modal-body">
      <slot />
    </div>
  </div>
</dialog>
