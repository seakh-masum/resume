---
import "@/styles/card.css";

interface Props {
  header?: string | HTMLElement;
  className?: string;
}

const { header, className = "" } = Astro.props;
---

<div class={`card ${className}`}>
  <header class="card-header">
    <!-- If a header slot is provided, use it -->
    <slot name="header">
      <!-- Otherwise fall back to text prop -->
      {header && <h3>{header}</h3>}
    </slot>
  </header>
  <div class="card-content">
    <slot />
  </div>
</div>
