---
// import Content from "@/components/react/Content";
import { sanity } from "@/lib/sanity";
import { resumeQuery } from "@/lib/queries";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Content from "@/components/ui/Content.astro";

// Build-time fetch (static)
const resume = await sanity.fetch(resumeQuery);
---

<BaseLayout>
  <Content resume={resume} isLoading={false} client:load />

  <!-- Optional modal -->
  <div slot="modal"></div>
</BaseLayout>
