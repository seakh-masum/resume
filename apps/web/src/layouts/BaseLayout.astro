---
import "@/styles/global.css";
import { homeMetadata as meta } from "@/styles/metadata";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${meta.canonical}#website`,
      url: meta.canonical,
      name: meta.openGraph.siteName,
      description: meta.description,
      inLanguage: "en-US",
      publisher: {
        "@id": `${meta.canonical}#person`,
      },
    },
    {
      "@type": "Person",
      "@id": `${meta.canonical}#person`,
      name: meta.author,
      url: meta.canonical,
      description: meta.description,
      jobTitle: "Software Engineer",
      image: meta.openGraph.image,
      sameAs: [meta.canonical],
      mainEntityOfPage: {
        "@id": `${meta.canonical}#website`,
      },
    },
  ],
};
---

<!doctype html>
<html lang="en" transition:animate="fade">
  <head>
    <meta charset="utf-8" />

    <!-- Viewport FIRST - critical for mobile -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Theme colors -->
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#ffffff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#0a0a0a"
    />

    <!-- Metadata -->
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="author" content={meta.author} />
    <meta name="robots" content={meta.robots} />
    <meta name="keywords" content={meta.keywords.join(", ")} />
    <link rel="canonical" href={meta.canonical} />
    <meta name="view-transition" content="same-origin" />

    <!-- Icons -->
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={meta.icons.favicon32}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href={meta.icons.favicon16}
    />
    <link rel="shortcut icon" href={meta.icons.shortcut} />
    <link rel="apple-touch-icon" href={meta.icons.apple} />
    <link
      rel="mask-icon"
      href={meta.icons.maskIcon.url}
      color={meta.icons.maskIcon.color}
    />

    <!-- Manifest -->
    <link rel="manifest" href={meta.manifest} />

    <!-- Open Graph -->
    <meta property="og:title" content={meta.openGraph.title} />
    <meta property="og:description" content={meta.openGraph.description} />
    <meta property="og:url" content={meta.openGraph.url} />
    <meta property="og:site_name" content={meta.openGraph.siteName} />
    <meta property="og:locale" content={meta.openGraph.locale} />
    <meta property="og:image" content={meta.openGraph.image} />
    <meta property="og:image:alt" content={meta.openGraph.imageAlt} />
    <meta property="og:type" content="website" />

    <!-- Twitter -->
    <meta name="twitter:card" content={meta.twitter.card} />
    <meta name="twitter:title" content={meta.twitter.title} />
    <meta name="twitter:description" content={meta.twitter.description} />
    <meta name="twitter:creator" content={meta.twitter.creator} />
    <meta name="twitter:site" content={meta.twitter.site} />
    <meta name="twitter:image" content={meta.twitter.image} />
    <meta name="twitter:image:alt" content={meta.twitter.imageAlt} />

    <!-- MS -->
    <meta name="msapplication-TileColor" content={meta.ms.tileColor} />
    <meta name="msapplication-config" content={meta.ms.config} />

    <!-- Critical CSS for font fallback -->
    <style>
      body {
        font-family:
          "Open Sans Variable",
          system-ui,
          -apple-system,
          sans-serif;
      }

      .skip-link {
        position: absolute;
        left: 0.75rem;
        top: 0.75rem;
        transform: translateY(-200%);
        padding: 0.5rem 0.75rem;
        border-radius: 0.375rem;
        background: #111827;
        color: #ffffff;
        text-decoration: none;
        z-index: 1000;
      }

      .skip-link:focus,
      .skip-link:focus-visible {
        transform: translateY(0);
        outline: 2px solid #ffffff;
        outline-offset: 2px;
      }
    </style>

    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </head>

  <body class="antialiased bg-surface font-sans m-0">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <main id="main-content" aria-label="Main content">
      <slot />
    </main>
  </body>
</html>
