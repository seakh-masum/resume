---
import type { Hobby } from "@/types/models";
import { getImage } from "@/utils/feature.util";

interface Props {
  data: Hobby[];
}

const { data } = Astro.props as Props;
---

<div
  class="flex flex-row flex-wrap justify-start items-center gap-1 sm:gap-2 min-h-hobby"
>
  {
    data.map((item, index) => (
      <div
        class="relative inline-flex items-center gap-1 h-8 py-1 px-3 rounded-xl 
        sm:text-sm text-xs min-w-25
        bg-surface dark:bg-${item.color}-100 dark:text-white
        hobby-item"
        style={`animation-delay: ${index * 0.06 + 0.1}s`}
      >
        <img
          src={getImage(item.icon, 20, 20)}
          alt="hobby-icon"
          class="w-4"
          width="20"
          height="20"
          loading="lazy"
        />
        <span>{item.name}</span>
      </div>
    ))
  }
</div>

<style>
  /* fade in + pop animation for each hobby */
  @keyframes fadeInPop {
    0% {
      opacity: 0;
      transform: translateY(6px) scale(0.85);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .hobby-item {
    opacity: 0;
    animation: fadeInPop 0.25s forwards ease-out;
  }

  .hobby-item:hover {
    transform: translateY(-2px) scale(1.05);
    transition: transform 0.2s ease-out;
  }

  .hobby-item:active {
    transform: scale(0.95);
    transition: transform 0.1s ease-in-out;
  }
</style>
