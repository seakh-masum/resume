---
import type { Project } from "@/types/project";
import ProjectDetails from "../modals/ProjectDetails.astro";
import Modal from "../ui/Modal.astro";

const { data } = Astro.props as {
  data: Project[];
};
---

<ul class="grid gap-4 sm:grid-cols-2 grid-cols-1 pt-3">
  {
    data.map((item, index) => (
      <li
        class="
          bg-surface list-none py-4 px-5 rounded-xl cursor-pointer
          relative overflow-hidden
          transition-all duration-300 ease-out
          hover:-translate-y-1.5 hover:scale-[1.03]
          hover:shadow-[0_4px_15px_rgba(59,130,246,0.5),0_0_20px_rgba(59,130,246,0.3)]
          hover:bg-hover
          active:scale-[0.97]
        "
      >
        <div
          class="block focus:outline-none focus:ring-2 focus:ring-primary rounded-md"
          style="view-transition-name: project-card-{project.slug}"
          onclick={`
              document.body.classList.add('no-scroll');
              document.getElementById('project-${item._key}').showModal();
            `}
        >
          <Modal id={item._key} type="project">
            <span slot="trigger">
              <b
                class="
                    text-text text-base block mb-1 relative
                    bg-size-[0%_2px]
                    bg-no-repeat bg-bottom-left
                    transition-[background-size] duration-300 ease-out
                    hover:bg-size-[100%_2px]
                  "
                style="background-image: linear-gradient(90deg, #3b82f6, #0ea5e9);"
              >
                {item.title}
              </b>
            </span>
            <ProjectDetails slot="content" data={item} />
          </Modal>

          <p class="text-text text-xs">{item.description}</p>
        </div>
      </li>
    ))
  }
</ul>
