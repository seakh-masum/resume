---
import type { HeaderContact } from "@/types/features";

interface Props {
  contacts: HeaderContact[];
  listClassName?: string;
  itemClassName?: string;
  iconClassName?: string;
  rowSpacingClassName?: string;
}

const {
  contacts = [],
  listClassName = "",
  itemClassName = "",
  iconClassName = "h-[3.35mm] w-[3.35mm] text-print-strong",
  rowSpacingClassName = "mt-[0.8mm]",
} = Astro.props as Props;

const phoneIconPath =
  "M6.62 10.79a15.054 15.054 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 .99-.24 11.37 11.37 0 0 0 3.57.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.85 21 3 13.15 3 3a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.23.2 2.43.57 3.57a1 1 0 0 1-.24.99l-2.21 2.23Z";
const emailIconPath =
  "M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z";
---

<ul class={listClassName}>
  {
    contacts.map((contact, index) => (
      <li
        class={`${index > 0 ? rowSpacingClassName : ""} flex items-center gap-[1.7mm] ${itemClassName}`.trim()}
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          class={iconClassName}
          fill="currentColor"
        >
          <path d={contact.type === "phone" ? phoneIconPath : emailIconPath} />
        </svg>
        <span>{contact.value}</span>
      </li>
    ))
  }
</ul>
