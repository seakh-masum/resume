---
import List from "../ui/List.astro";

interface Props {
  introduction: string;
  summary: string[];
}

const { introduction, summary } = Astro.props;
---

<div class="min-h-about-me">
  <div class="pt-1">
    {introduction && <p class="text-text-light text-sm">{introduction}</p>}
    {summary && summary.length > 0 && <List data={summary} />}
  </div>
</div>
