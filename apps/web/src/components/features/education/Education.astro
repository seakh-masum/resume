---
import Stepper from "../../ui/Stepper.astro";
import SkeletonList from "../../ui/SkeletonList.astro";
import type { Education } from "./education";

type Props = {
  data: Education[];
};

const { data } = Astro.props;
---

<div class="mt-4 sm:ml-6 pt-1 mr-0 mb-0">
  {
    data.map((item, index) => (
      <Stepper
        hasLine={index < data.length - 1}
        index={index}
        stepperIndex={`${item.startYear} - ${item.endYear}`}
        heading={item.degree}
        extraHeading={item.stream}
        subHeading={item.institute}
        desc={item.marks}
        link={item.link}
      />
    ))
  }
</div>
