---
import "@/styles/card.css";

interface Props {
  header?: string | HTMLElement;
  className?: string;
  ariaLabel?: string;
}

const { header, className = "", ariaLabel } = Astro.props;
const computedAriaLabel =
  ariaLabel || (typeof header === "string" ? `${header} section` : undefined);
---

<div class={`card ${className}`} role="region" aria-label={computedAriaLabel}>
  <header class="card-header">
    <!-- If a header slot is provided, use it -->
    <slot name="header">
      <!-- Otherwise fall back to text prop -->
      {header && <h3>{header}</h3>}
    </slot>
  </header>
  <div class="card-content">
    <slot />
  </div>
</div>
