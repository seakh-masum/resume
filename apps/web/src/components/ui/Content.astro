---
import Card from "./Card.astro";
import CircleProgressGrid from "./CircleProgressGrid.astro";
import AboutMe from "../features/AboutMe.astro";
import HobbyList from "../features/Hobby.astro";
import Project from "../features/Project.astro";
import Experience from "../features/experience/Experience.astro";
import TotalExperience from "./TotalExperience.astro";
import Profile from "../features/Profile.astro";
import Education from "../features/education/Education.astro";
import Certification from "../features/certification/Certification.astro";
import type { ResumeData, ResumeExperience } from "@/types/models";

interface Props {
  resume: ResumeData;
}

const { resume } = Astro.props as Props;

// Use your existing calculateTotalTenure utility
import { calculateTotalTenure } from "@/utils";
import DownloadButton from "../features/download-btn/DownloadButton.astro";

const { years, months } = calculateTotalTenure(resume.experience);
---

<div class="w-full bg-surface">
  <div class="relative mx-auto max-w-7xl px-2 py-3 sm:p-3">
    <Profile data={resume?.profile} contacts={resume?.contacts || []} />

    <div class="flex flex-col gap-4 sm:flex-row">
      <div class="flex flex-col basis-[45%]">
        <Card header="About Me">
          <AboutMe
            introduction={resume?.profile.introduction || ""}
            summary={resume?.profile?.summary || []}
          />
        </Card>
        <Card header="Hobbies">
          <HobbyList data={resume.hobbies} />
        </Card>
      </div>
      <div class="flex flex-col basis-[55%]">
        <Card header="Skills">
          <CircleProgressGrid features="skills" data={resume.skills} />
        </Card>
        <Card header="Tools">
          <CircleProgressGrid features="tools" data={resume.tools} />
        </Card>
      </div>
    </div>

    <div>
      <Card>
        <div slot="header">
          <TotalExperience years={years} months={months} />
        </div>
        <Experience data={resume.experience} />
      </Card>
    </div>

    <div class="flex flex-col gap-4 sm:flex-row">
      <div class="flex flex-col basis-[45%]">
        <Card header="Education">
          <Education data={resume.education} />
        </Card>
        <Card header="Certifications">
          <Certification data={resume.certifications || []} />
        </Card>
      </div>
      <div class="flex flex-col basis-[55%]">
        <Card header="Projects">
          <Project data={resume.projects} />
        </Card>
      </div>
    </div>
  </div>
  <DownloadButton />
</div>
