---
import ExpansionPanel from "./ExpansionPanel.astro";

interface Props {
  index: number;
  stepperIndex: string;
  hasLine?: boolean;
  link: string;
  heading: string;
  extraHeading?: string;
  subHeading?: string;
  desc?: string;
  list?: string[];
}

const {
  index,
  stepperIndex,
  hasLine,
  link,
  heading,
  extraHeading,
  subHeading,
  desc,
  list = [],
} = Astro.props;
---

<div class="stepper-row">
  <!-- Left stepper -->
  <div class="stepper-left">
    <div class={`stepper-circle md:min-w-36 rounded-full md:rounded-none`}>
      <span class="block md:hidden">{index + 1}</span>
      <span class="hidden md:block">{stepperIndex}</span>
    </div>

    {hasLine && <div class="stepper-line" />}
  </div>

  <!-- Right content -->
  <div class="stepper-content">
    <ExpansionPanel defaultOpen={false}>
      <div slot="header">
        <p class="heading">
          {heading}
          {
            extraHeading && (
              <>
                {" | "}
                <b>{extraHeading}</b>
              </>
            )
          }
        </p>

        {subHeading && <p class="subheading">{subHeading}</p>}
      </div>
      <div slot="content">
        {desc && <b class="desc">{desc}</b>}

        {
          list.length > 0 && (
            // <ExpansionPanel title="Key Responsibilities">
            <ul class="list">
              {list.map((item, i) => (
                <li class="list-item" style={`--i:${i}`}>
                  {item}
                </li>
              ))}
            </ul>
            // </ExpansionPanel>
          )
        }
      </div>
    </ExpansionPanel>
  </div>
</div>

<script>
  const rows = document.querySelectorAll(".stepper-row");

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.25 },
  );

  rows.forEach((row) => observer.observe(row));
</script>

<style>
  /* ---------------- ROW ENTRY ---------------- */
  .stepper-row {
    display: flex;
    margin-bottom: 0.5rem;
    opacity: 0;
  }

  .stepper-row[data-mobile="true"] {
    transform: translateY(20px);
  }

  .stepper-row[data-mobile="false"] {
    transform: translateX(-40px);
  }

  .stepper-row.visible {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.5s ease-out,
      transform 0.5s ease-out;
  }

  /* ---------------- LEFT ---------------- */
  .stepper-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-right: 1.5rem;
  }

  .stepper-circle {
    width: 2.25rem;
    height: 2.25rem;
    background: var(--color-primary);
    color: black;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .stepper-circle.desktop {
    min-width: 8.75rem;
    border-radius: 0;
  }

  .stepper-circle:hover {
    transform: scale(1.2);
    box-shadow:
      0 0 10px #3b82f6,
      0 0 20px #3b82f6;
  }

  /* ---------------- LINE ---------------- */
  .stepper-line {
    width: 0.25rem;
    background: var(--color-primary);
    flex-grow: 1;
    transform-origin: top;
    animation: grow-line 0.6s ease-out forwards;
    margin-top: 0.5rem;
  }

  @keyframes grow-line {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }

  /* ---------------- CONTENT ---------------- */
  .stepper-content {
    margin-top: -0.25rem;
    margin-bottom: 1rem;
    transition: transform 0.2s ease;
    width: 100%;
  }

  .stepper-content:hover {
    transform: scale(1.02);
  }

  .heading {
    font-size: 1.125rem;
    font-weight: 500;
  }

  .heading a {
    font-weight: 700;
  }

  .subheading {
    font-size: 0.875rem;
    margin: 0.5rem 0;
    color: var(--text-light);
  }

  .desc {
    display: block;
    font-weight: 800;
    margin-bottom: 1rem;
  }

  /* ---------------- LIST ---------------- */
  .list {
    padding-left: 1rem;
  }

  .list-item {
    list-style: disc;
    opacity: 0;
    transform: translateX(-8px);
    animation: list-in 0.25s ease-out forwards;
    animation-delay: calc(var(--i) * 0.1s);
  }

  @keyframes list-in {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
</style>
