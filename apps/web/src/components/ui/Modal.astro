---
import CloseIcon from "../icons/CloseIcon.astro";
import "@/styles/modal.css";

interface Props {
  id: string;
  type?: string;
}

const { id, type = "item" } = Astro.props;
const modalId = `${type}-${id}`;
---

<>
  <!-- Trigger Button -->
  <button
    class="text-left"
    onclick={`document.body.classList.add('no-scroll'); document.getElementById('${modalId}')?.showModal();`}
  >
    <slot name="trigger" />
  </button>

  <!-- Modal Dialog -->
  <dialog
    id={modalId}
    class="modal fixed inset-0 z-50 m-0 h-screen w-screen max-h-none max-w-none"
    onclose="document.body.classList.remove('no-scroll')"
    oncancel="document.body.classList.remove('no-scroll')"
  >
    <!-- Backdrop -->
    <form method="dialog" class="modal-backdrop absolute inset-0"></form>

    <!-- Modal content -->
    <div
      class="modal-content bg-accent shadow-xl"
      data-sheet
      onclick="event.stopPropagation()"
    >
      <!-- Sticky header -->
      <div class="modal-header">
        <!-- Drag handle (mobile) -->
        <div class="sheet-handle"></div>

        <!-- Close Button -->
        <form method="dialog">
          <button class="modal-close" aria-label="Close">
            <CloseIcon />
          </button>
        </form>
      </div>

      <!-- Scrollable body -->
      <div class="modal-body">
        <slot name="content" />
      </div>
    </div>
  </dialog>
</>
