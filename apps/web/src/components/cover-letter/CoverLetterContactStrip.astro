---
import CoverLetterContactRow from "@/components/cover-letter/CoverLetterContactRow.astro";

interface Props {
  phoneValue: string;
  emailValue: string;
  location: string;
}

const { phoneValue, emailValue, location } = Astro.props as Props;
---

<section
  class="grid grid-cols-[52mm_minmax(0,1fr)] border-b border-print-border/40 text-[3.2mm] max-[900px]:grid-cols-1 print:grid-cols-[52mm_minmax(0,1fr)]"
>
  <div
    class="border-r border-print-border/40 p-[2.8mm_4mm] max-[900px]:border-r-0 max-[900px]:border-b print:border-r print:border-b-0"
  >
    <CoverLetterContactRow value={phoneValue}>
      <svg
        slot="icon"
        aria-hidden="true"
        viewBox="0 0 24 24"
        class="h-[3.3mm] w-[3.3mm] text-print-strong"
        fill="currentColor"
        ><path
          d="M6.62 10.79a15.054 15.054 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 .99-.24 11.37 11.37 0 0 0 3.57.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.85 21 3 13.15 3 3a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.23.2 2.43.57 3.57a1 1 0 0 1-.24.99l-2.21 2.23Z"
        ></path></svg
      >
    </CoverLetterContactRow>
  </div>

  <div class="p-[2.8mm_4mm] text-print-muted">
    <CoverLetterContactRow value={emailValue}>
      <svg
        slot="icon"
        aria-hidden="true"
        viewBox="0 0 24 24"
        class="h-[3.3mm] w-[3.3mm] text-print-strong"
        fill="currentColor"
        ><path
          d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z"
        ></path></svg
      >
    </CoverLetterContactRow>
    <CoverLetterContactRow
      value={location}
      valueId="cl-location"
      className="m-[0.5mm_0_0]"
      align="start"
    >
      <svg
        slot="icon"
        aria-hidden="true"
        viewBox="0 0 24 24"
        class="mt-[0.2mm] h-[3.3mm] w-[3.3mm] text-print-strong"
        fill="currentColor"
        ><path
          d="M12 2C8.13 2 5 5.13 5 9c0 4.97 5.41 11.28 6.01 11.95a1.3 1.3 0 0 0 1.98 0C13.59 20.28 19 13.97 19 9c0-3.87-3.13-7-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5Z"
        ></path></svg
      >
    </CoverLetterContactRow>
  </div>
</section>
