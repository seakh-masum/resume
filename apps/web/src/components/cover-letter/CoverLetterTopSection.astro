---
interface Props {
  fullName: string;
  role: string;
  heroImage: string;
  initials: string;
  aboutMeText: string;
}

const { fullName, role, heroImage, initials, aboutMeText } =
  Astro.props as Props;
---

<header
  class="grid grid-cols-[52mm_minmax(0,1fr)] border-b border-print-border/40 max-[900px]:grid-cols-1 print:grid-cols-[52mm_minmax(0,1fr)]"
>
  <div
    class="grid place-items-center border-r border-print-border/40 p-[6mm] max-[900px]:border-r-0 print:border-r print:border-print-border/40"
  >
    <div class="overflow-hidden">
      {
        heroImage ? (
          <img
            src={heroImage}
            alt={fullName}
            width="280"
            height="280"
            class="h-full w-full object-cover grayscale"
          />
        ) : (
          <div class="grid h-full w-full place-items-center text-[12mm] font-bold text-white">
            {initials}
          </div>
        )
      }
    </div>
  </div>

  <div class="p-[6mm]">
    <h1
      class="m-0 font-mono text-[11.2mm] font-bold uppercase leading-none tracking-[0.02em] text-print-ink"
    >
      {fullName}
    </h1>
    <p
      class="m-[1.6mm_0_0] text-[4.2mm] uppercase leading-none tracking-[0.04em] text-print-muted"
    >
      {role}
    </p>

    <h2 class="m-[7mm_0_0] text-[6.1mm] font-bold uppercase text-print-ink">
      About Me
    </h2>
    <p class="m-[1.8mm_0_0] text-[3.25mm] leading-[1.55] text-print-muted">
      {
        aboutMeText ||
          "Share a concise profile summary that highlights your strengths and work style."
      }
    </p>
  </div>
</header>
