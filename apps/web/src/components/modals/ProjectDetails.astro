---
import SubHeading from "../ui/SubHeading.astro";
import ChipList from "../ui/ChipList.astro";
import List from "../ui/List.astro";
import DialogTitle from "../ui/DialogTitle.astro";
import type { Project } from "@/types/project";

interface Props {
  data: Project;
}

const { data } = Astro.props;
---

<div class="flex flex-col gap-7 text-text">
  <!-- Header -->
  <section>
    <DialogTitle title={data?.title} link={data?.link ?? ""} />
    {
      data?.startDate && (
        <p class="text-text-light mt-2">
          {data?.startDate} –<span>{data.endDate ?? "Present"}</span>
        </p>
      )
    }
  </section>

  <!-- Description -->
  <section>
    <SubHeading title="Description" />
    <p class="text-sm mt-2 font-medium">
      {data?.description}
    </p>
  </section>

  <!-- Skills -->
  {
    data?.techStacks?.length && (
      <section>
        <SubHeading title="Skills" />
        <ChipList data={data?.techStacks} />
      </section>
    )
  }

  <!-- Sector & Type -->
  <div class="flex flex-row items-start gap-3">
    <div class="basis-1/2">
      <SubHeading title="Sector" />
      <ChipList data={[data?.sector]} />
    </div>

    <div class="basis-1/2">
      <SubHeading title="Project Type" />
      <ChipList data={[data?.type]} />
    </div>
  </div>

  <!-- Role -->
  <section>
    <SubHeading title="Role" />
    <p class="text-sm mt-2">{data?.role}</p>
  </section>

  <!-- Responsibilities -->
  {
    data?.responsibilities?.length && (
      <section>
        <SubHeading title="Responsibilities" />
        <List data={data?.responsibilities} />
      </section>
    )
  }

  <!-- Achievements -->
  {
    data?.achievements?.length && (
      <section>
        <SubHeading title="Achievements" />
        <List data={data?.achievements} />
      </section>
    )
  }

  <!-- Team -->
  {
    data?.members?.length && (
      <section>
        <SubHeading title="Team Mates" />
        <ChipList data={data?.members} />
      </section>
    )
  }
</div>
