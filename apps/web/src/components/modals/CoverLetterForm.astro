---
interface Props {
  roPlaceholder?: string;
  rolePlaceholder?: string;
  companyPlaceholder?: string;
  locationPlaceholder?: string;
  salutationPlaceholder?: string;
  jobTitlePlaceholder?: string;
  relevantTechPlaceholder?: string;
}

const {
  roPlaceholder = "Hiring Manager",
  rolePlaceholder = "Talent Acquisition Team",
  companyPlaceholder = "Company Name",
  locationPlaceholder = "State, Country, 12345",
  salutationPlaceholder = "Dear Sir,",
  jobTitlePlaceholder = "Software Engineer",
  relevantTechPlaceholder = "React, TypeScript",
} = Astro.props as Props;
---

<form
  id="cover-letter-form"
  class="space-y-3"
  aria-labelledby="cover-letter-form-title"
>
  <h3 id="cover-letter-form-title" class="m-0 text-lg font-semibold text-text">
    Cover Letter Details
  </h3>
  <p class="m-0 text-sm text-text-light">
    Fill out details to prefill your cover letter.
  </p>

  <label
    class="flex flex-col gap-1.5 text-sm font-medium text-text"
    for="cl-ro"
  >
    RO
    <input
      id="cl-ro"
      name="ro"
      type="text"
      value={roPlaceholder}
      placeholder={roPlaceholder}
      class="rounded-lg border border-hover bg-surface px-3 py-2 text-sm text-text outline-none focus:border-primary"
    />
  </label>

  <label
    class="flex flex-col gap-1.5 text-sm font-medium text-text"
    for="cl-role"
  >
    Role
    <input
      id="cl-role"
      name="role"
      type="text"
      value={rolePlaceholder}
      placeholder={rolePlaceholder}
      class="rounded-lg border border-hover bg-surface px-3 py-2 text-sm text-text outline-none focus:border-primary"
    />
  </label>

  <label
    class="flex flex-col gap-1.5 text-sm font-medium text-text"
    for="cl-company"
  >
    Company
    <input
      id="cl-company"
      name="company"
      type="text"
      placeholder={companyPlaceholder}
      class="rounded-lg border border-hover bg-surface px-3 py-2 text-sm text-text outline-none focus:border-primary"
    />
  </label>

  <label
    class="flex flex-col gap-1.5 text-sm font-medium text-text"
    for="cl-location"
  >
    Location
    <input
      id="cl-location"
      name="location"
      type="text"
      placeholder={locationPlaceholder}
      class="rounded-lg border border-hover bg-surface px-3 py-2 text-sm text-text outline-none focus:border-primary"
    />
  </label>

  <label
    class="flex flex-col gap-1.5 text-sm font-medium text-text"
    for="cl-job-title"
  >
    Job Title
    <input
      id="cl-job-title"
      name="jobTitle"
      type="text"
      value={jobTitlePlaceholder}
      placeholder={jobTitlePlaceholder}
      class="rounded-lg border border-hover bg-surface px-3 py-2 text-sm text-text outline-none focus:border-primary"
    />
  </label>

  <label
    class="flex flex-col gap-1.5 text-sm font-medium text-text"
    for="cl-relevant-tech"
  >
    Relevant Tech
    <input
      id="cl-relevant-tech"
      name="relevantTech"
      type="text"
      value={relevantTechPlaceholder}
      placeholder={relevantTechPlaceholder}
      class="rounded-lg border border-hover bg-surface px-3 py-2 text-sm text-text outline-none focus:border-primary"
    />
  </label>

  <label
    class="flex flex-col gap-1.5 text-sm font-medium text-text"
    for="cl-salutation"
  >
    Salutation
    <input
      id="cl-salutation"
      name="salutation"
      type="text"
      value={salutationPlaceholder}
      placeholder={salutationPlaceholder}
      class="rounded-lg border border-hover bg-surface px-3 py-2 text-sm text-text outline-none focus:border-primary"
    />
  </label>

  <div class="pt-2">
    <button
      type="submit"
      aria-label="Download cover letter as PDF"
      class="w-full cursor-pointer rounded-lg border border-[#111111] bg-print-primary px-3.5 py-2 text-sm font-semibold text-[#111111]"
    >
      Download Cover Letter
    </button>
  </div>
</form>

<script>
  import { COVER_LETTER_PRINT_FRAME_ID } from "@/const";
  import { runOnAstroPageLoad } from "@/utils/astro-page.util";
  import { openPrintableDialog } from "@/utils/print-dialog.util";

  const getFieldValue = (form: HTMLFormElement, name: string) => {
    const input = form.querySelector<HTMLInputElement>(`[name="${name}"]`);
    const typed = String(new FormData(form).get(name) || "").trim();
    const hinted = String(input?.placeholder || "").trim();
    return typed || hinted;
  };

  const buildCoverLetterPath = (form: HTMLFormElement) => {
    const params = new URLSearchParams();
    const ro = getFieldValue(form, "ro");
    const role = getFieldValue(form, "role");
    const company = getFieldValue(form, "company");
    const location = getFieldValue(form, "location");
    const salutation = getFieldValue(form, "salutation");
    const jobTitle = getFieldValue(form, "jobTitle");
    const relevantTech = getFieldValue(form, "relevantTech");

    if (ro) params.set("to", ro);
    if (role) params.set("role", role);
    if (company) params.set("company", company);
    if (location) params.set("location", location);
    if (salutation) params.set("greeting", salutation);
    if (jobTitle) params.set("jobTitle", jobTitle);
    if (relevantTech) params.set("relevantTech", relevantTech);

    return `/cover-letter?${params.toString()}`;
  };

  const bindCoverLetterFormSubmit = () => {
    const form = document.getElementById("cover-letter-form");
    if (!form || form.dataset.submitBound === "true") {
      return;
    }

    form.dataset.submitBound = "true";
    form.addEventListener("submit", (event: SubmitEvent) => {
      event.preventDefault();
      const target = event.currentTarget as HTMLFormElement;
      const path = buildCoverLetterPath(target);
      openPrintableDialog({
        path,
        kind: "cover-letter",
        frameId: COVER_LETTER_PRINT_FRAME_ID,
        mobileChromeRouteFallback: false,
      });
    });
  };

  runOnAstroPageLoad(bindCoverLetterFormSubmit);
</script>
