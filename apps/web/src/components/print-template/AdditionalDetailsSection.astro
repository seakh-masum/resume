---
import SectionTitle from "@/components/print-template/SectionTitle.astro";
import TitledListSection from "@/components/print-template/TitledListSection.astro";
import ProjectCard from "@/components/print-template/ProjectCard.astro";
import {
  DIVIDER_PANEL_CLASS,
  LEFT_COLUMN_CLASS,
  TWO_COLUMN_SECTION_CLASS,
} from "@/components/print-template/classNames";
import type {
  CertificationPrintItem,
  NameItem,
  ProjectItem,
  SkillItem,
} from "@/types/features";

interface Props {
  projects: ProjectItem[];
  tools: NameItem[];
  hobbies: NameItem[];
  skills: SkillItem[];
  certifications: CertificationPrintItem[];
}

const { projects, tools, hobbies, skills, certifications } =
  Astro.props as Props;
---

<section class="mt-[8mm]">
  <div class={TWO_COLUMN_SECTION_CLASS}>
    <aside class={LEFT_COLUMN_CLASS}>
      <TitledListSection
        title="Skills"
        items={skills}
        fallbackLabel="Skill"
        listClassName="text-[3.45mm]"
        containerClassName="mb-[4.4mm]"
      />

      <TitledListSection
        title="Tools"
        items={tools}
        fallbackLabel="Tool"
        containerClassName="mt-[4.8mm] mb-[4.4mm]"
        limit={12}
      />

      <TitledListSection
        title="Hobbies"
        items={hobbies}
        fallbackLabel="Hobby"
        containerClassName="mt-[4.8mm]"
        limit={8}
      />
      {
        certifications.length > 0 && (
          <section class="mt-[4.8mm] mb-[4.4mm]">
            <SectionTitle text="Certifications" />
            <ul class="m-0 list-outside list-disc pl-[4.5mm] marker:text-print-subtle">
              {certifications.slice(0, 12).map((item) => (
                <li class="mb-[1.8mm] pl-[0.6mm]">
                  <p class="m-0 wrap-break-word text-[3.35mm] leading-[1.38] text-print-base">
                    {item?.name || "Certification"}
                  </p>
                  {(item?.issuer || item?.dateRange) && (
                    <p class="m-[0.4mm_0_0] wrap-break-word text-[3.05mm] leading-[1.35] text-print-muted">
                      {[item?.issuer, item?.dateRange]
                        .filter(Boolean)
                        .join(" | ")}
                    </p>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </aside>

    <section class={DIVIDER_PANEL_CLASS}>
      <SectionTitle text="Projects" />

      {
        projects.length > 0 ? (
          <div class="mt-0">
            {projects.map((item, index) => (
              <ProjectCard item={item} index={index} />
            ))}
          </div>
        ) : (
          <p class="m-[2.2mm_0_0] text-[3.4mm] leading-[1.45] text-print-muted">
            No projects added yet.
          </p>
        )
      }
    </section>
  </div>
</section>
