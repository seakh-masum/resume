---
import type { ExperienceItem } from "@/types/features";

interface Props {
  item: ExperienceItem;
}

const { item } = Astro.props as Props;
---

<article class="relative mb-[6.4mm] break-inside-avoid">
  <div>
    <p
      class="m-[1mm_0_0.6mm] text-[4.1mm] font-bold leading-tight tracking-[0.04em] uppercase text-print-ink"
    >
      {item?.company || "Company"}
    </p>
    <p
      class="m-[0_0_2mm] text-[3.45mm] font-semibold tracking-[0.07em] uppercase text-print-strong"
    >
      {item?.designation || "Role"}

      <span class="mx-[2mm]">|</span>

      <span
        class="m-0 text-[3.6mm] leading-[1.3] tracking-[0.06em] text-print-subtle"
      >
        {item.dateRange}
      </span>
    </p>
    {
      item?.shortDesc && (
        <p class="m-0 wrap-break-word text-[3.4mm] leading-[1.45] text-print-muted">
          {item.shortDesc}
        </p>
      )
    }

    {
      item.shortRoles.length > 0 && (
        <ul class="mt-[2mm] list-outside list-disc pl-[4.5mm] text-[3.25mm] leading-[1.45] text-print-base marker:text-print-subtle">
          {item.shortRoles.map((role) => (
            <li class="mb-[1.5mm] wrap-break-word pl-[0.6mm]">{role}</li>
          ))}
        </ul>
      )
    }
  </div>
</article>
