---
import SectionTitle from "@/components/resume/SectionTitle.astro";
import ExperienceTimelineItem from "@/components/resume/ExperienceTimelineItem.astro";
import EducationCard from "@/components/resume/EducationCard.astro";
import {
  DIVIDER_PANEL_CLASS,
  LEFT_COLUMN_CLASS,
  TWO_COLUMN_SECTION_CLASS,
} from "@/components/resume/classNames";
import type { EducationItem, ExperienceItem } from "@/types/features";

interface Props {
  education: EducationItem[];
  experience: ExperienceItem[];
}

const { education, experience } = Astro.props as Props;
---

<section
  class={`mt-[10mm] ${TWO_COLUMN_SECTION_CLASS}`}
  aria-label="Resume education and experience section"
>
  <aside class={LEFT_COLUMN_CLASS} aria-label="Education details">
    <SectionTitle text="Education" />

    <div class="mt-0">
      {education.map((item) => <EducationCard item={item} />)}
    </div>
  </aside>

  <section class={DIVIDER_PANEL_CLASS} aria-label="Experience details">
    <SectionTitle text="Experience" />

    <div class="mt-0">
      {experience.map((item) => <ExperienceTimelineItem item={item} />)}
    </div>
  </section>
</section>
