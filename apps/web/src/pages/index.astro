---
// import Content from "@/components/react/Content";
import { getResumeData } from "@/lib/resume-data";
import { buildHomePageTemplateData } from "@/lib/template-data";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Content from "@/components/ui/Content.astro";

// Build-time fetch (static)
const resume = await getResumeData();
const pageData = buildHomePageTemplateData(resume);
---

<BaseLayout>
  <Content resume={pageData.resume} />

  <!-- Optional modal -->
  <div slot="modal"></div>
</BaseLayout>
