---
// import Content from "@/components/react/Content";
import { sanity } from "@/lib/sanity";
import { resumeQuery } from "@/lib/queries";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Content from "@/components/ui/Content.astro";
import type { ResumeData } from "@/types/models";

// Build-time fetch (static)
const resume = (await sanity.fetch(resumeQuery)) as ResumeData;
---

<BaseLayout>
  <Content resume={resume} />

  <!-- Optional modal -->
  <div slot="modal"></div>
</BaseLayout>
