---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { sanity } from "@/lib/sanity";
import { resumeQuery } from "@/lib/queries";
import { getImage } from "@/utils/feature.util";
import CoverLetterTopSection from "@/components/cover-letter/CoverLetterTopSection.astro";
import CoverLetterContactStrip from "@/components/cover-letter/CoverLetterContactStrip.astro";
import CoverLetterBodySection from "@/components/cover-letter/CoverLetterBodySection.astro";
import {
  getEmailContact,
  getPhoneContact,
  getWebsiteContact,
} from "@/utils/contact.util";
import type { ResumeData } from "@/types/models";
import { currentDate } from "@/utils/date.util";

const resume = (await sanity.fetch(resumeQuery)) as ResumeData;

const profile = resume?.profile ?? {};
const contacts = resume?.contacts ?? [];
const experiences = resume?.experience ?? [];
const skills = resume?.skills ?? [];

const fullName = (profile?.name ?? "Your Name").trim();
const role = profile?.title ?? "UI/UX Designer";
const initials =
  fullName
    .split(" ")
    .filter(Boolean)
    .map((part) => part[0]?.toUpperCase() ?? "")
    .slice(0, 2)
    .join("") || "YN";

const heroImage = profile?.image ? getImage(profile.image, 560, 560) : "";
const phoneContact = getPhoneContact(contacts);
const emailContact = getEmailContact(contacts);
const websiteContact = getWebsiteContact(contacts);

const params = Astro.url.searchParams;

const getParam = (key: string, fallback: string) => {
  const value = params.get(key)?.trim();
  return value ? value : fallback;
};

const toSortableTime = (value?: string) => {
  if (!value) return 0;
  const parsed = Date.parse(value);
  return Number.isNaN(parsed) ? 0 : parsed;
};

const latestExperience = [...experiences].sort((a, b) => {
  const aTime = toSortableTime(a?.releaseDate || a?.joiningDate);
  const bTime = toSortableTime(b?.releaseDate || b?.joiningDate);
  return bTime - aTime;
})[0];

const currentJobTitle = latestExperience?.designation || role;
const lastCompany = latestExperience?.company || "your most recent company";
const primarySkill = skills[0]?.name || "frontend development";
const secondarySkill = skills[1]?.name || "problem-solving";
const latestAccomplishment =
  latestExperience?.roles?.[0] ||
  latestExperience?.desc ||
  "delivered measurable improvements across product experiences";

const recipientName = getParam("to", "Hiring Manager");
const recipientRole = getParam("role", "Talent Acquisition Team");
const recipientCompany = getParam(
  "company",
  latestExperience?.company || "Company Name",
);
const recipientLocation = getParam("location", "State, Country, 12345");
const salutation = getParam("greeting", "Dear Sir,");
const jobTitle = getParam("jobTitle", recipientRole || "Software Engineer");

const introSummary = profile?.introduction || "";
const summaryText = Array.isArray(profile?.summary)
  ? profile.summary.join(" ")
  : "";

const mergedBio = `${introSummary} ${summaryText}`.trim();

const clipText = (value: string, maxLength: number) => {
  if (!value) return "";
  if (value.length <= maxLength) return value;
  return `${value.slice(0, maxLength).trimEnd()}...`;
};

const aboutMeText = clipText(mergedBio, 340);

const paragraphOne = `I am writing to express my strong interest in the ${jobTitle} position at ${recipientCompany}. With a solid background in frontend technology and a proven track record of ${primarySkill} and ${secondarySkill}, I am confident in my ability to make an immediate and positive impact on your team.`;

const paragraphTwo = `In my most recent role as a ${currentJobTitle} at ${lastCompany}, I successfully ${latestAccomplishment}. My experience has equipped me with a deep understanding of [Hard Skill/Technology relevant to the job], which aligns perfectly with the requirements of this role.`;

const paragraphThree = `I would welcome the opportunity to discuss how my background, skills, and certifications can contribute to the continued success of ${recipientCompany}. Thank you for considering my application. I have attached my resume for your review and look forward to the possibility of an interview.`;
---

<BaseLayout>
  <div
    class="min-h-0 bg-print-bg py-0 font-sans text-print-base [--mono-ink:var(--print-ink)] [--mono-strong:var(--print-strong)] [--mono-base:var(--print-base)] [--mono-muted:var(--print-muted)] [--mono-subtle:var(--print-subtle)] [--print-primary-rgb:185_218_63] max-[900px]:bg-[linear-gradient(180deg,rgba(var(--print-primary-rgb),0.18)_0%,rgba(var(--print-primary-rgb),0.05)_18%,#fff_52%)]"
  >
    <div
      class="fixed right-3.5 top-3.5 z-20 flex items-center gap-2 print:hidden"
    >
      <a
        href="/resume"
        class="inline-flex items-center justify-center rounded-full border border-print-border bg-print-bg px-3 py-1.5 text-[0.82rem] font-semibold text-print-ink shadow-[0_4px_14px_rgba(17,24,39,0.12)]"
      >
        Resume
      </a>
      <button
        class="cursor-pointer rounded-full border border-print-border bg-print-primary px-3.5 py-1.5 text-[0.85rem] font-semibold text-print-ink shadow-[0_4px_14px_rgba(17,24,39,0.18)]"
        type="button"
        onclick="window.print()"
      >
        Print Cover Letter
      </button>
    </div>

    <article
      class="mx-auto box-border flex min-h-[calc(297mm-16mm)] w-full max-w-[194mm] flex-col border-0 bg-print-bg p-[5.2mm_4.6mm] text-[93%] text-print-base shadow-none max-[900px]:border-0 print:border-0 print:p-0"
    >
      <CoverLetterTopSection
        fullName={fullName}
        role={role}
        heroImage={heroImage}
        initials={initials}
        aboutMeText={aboutMeText}
      />

      <CoverLetterContactStrip
        phoneValue={phoneContact?.value || "+000 0000 0000"}
        emailValue={emailContact?.value || "www.example.com"}
        recipientLocation={recipientLocation}
      />

      <CoverLetterBodySection
        recipientName={recipientName}
        recipientRole={recipientRole}
        recipientCompany={recipientCompany}
        phoneValue={phoneContact?.value || "+00 1234 5678 9000"}
        recipientLocation={recipientLocation}
        fullName={fullName}
        role={role}
        salutation={salutation}
        currentDate={currentDate}
        paragraphOne={paragraphOne}
        paragraphTwo={paragraphTwo}
        paragraphThree={paragraphThree}
      />

      <div
        id="cl-template-meta"
        hidden
        data-primary-skill={primarySkill}
        data-secondary-skill={secondarySkill}
        data-current-job-title={currentJobTitle}
        data-last-company={lastCompany}
        data-latest-accomplishment={latestAccomplishment}
      >
      </div>
    </article>
  </div>
</BaseLayout>

<style is:global>
  @import "@/styles/print-template.css";
</style>

<script>
  const applyCoverLetterParams = () => {
    const params = new URLSearchParams(window.location.search);
    const mapping = [
      { param: "to", id: "cl-to" },
      { param: "role", id: "cl-to-role" },
      { param: "company", id: "cl-company" },
      { param: "location", id: "cl-location" },
      { param: "greeting", id: "cl-salutation" },
    ];

    for (const item of mapping) {
      const value = params.get(item.param)?.trim();
      const target = document.getElementById(item.id);
      if (value && target) {
        target.textContent = value;
      }
    }

    const meta = document.getElementById("cl-template-meta");
    const paragraphOne = document.getElementById("cl-paragraph-1");
    const paragraphThree = document.getElementById("cl-paragraph-3");

    if (!meta || !paragraphOne || !paragraphThree) {
      return;
    }

    const dataset = meta.dataset;
    const roleText = document.getElementById("cl-to-role")?.textContent?.trim();
    const companyText = document
      .getElementById("cl-company")
      ?.textContent?.trim();

    const jobTitle =
      params.get("jobTitle")?.trim() || roleText || "Software Engineer";
    const recipientCompany = companyText || "Company Name";
    const primarySkill = dataset.primarySkill || "frontend development";
    const secondarySkill = dataset.secondarySkill || "problem-solving";

    paragraphOne.textContent = `I am writing to express my strong interest in the ${jobTitle} position at ${recipientCompany}. With a solid background in frontend technology and a proven track record of ${primarySkill} and ${secondarySkill}, I am confident in my ability to make an immediate and positive impact on your team.`;

    paragraphThree.textContent = `I would welcome the opportunity to discuss how my background, skills, and certifications can contribute to the continued success of ${recipientCompany}. Thank you for considering my application. I have attached my resume for your review and look forward to the possibility of an interview.`;
  };

  applyCoverLetterParams();
  document.addEventListener("astro:page-load", applyCoverLetterParams);
</script>
