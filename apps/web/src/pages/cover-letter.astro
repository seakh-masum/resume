---
import DocumentPrintLayout from "@/layouts/DocumentPrintLayout.astro";
import { sanity } from "@/lib/sanity";
import { resumeQuery } from "@/lib/queries";
import { COVER_LETTER_TEMPLATE_META_ID } from "@/const";
import { buildCoverLetterPageTemplateData } from "@/lib/template-data";
import CoverLetterTopSection from "@/components/cover-letter/CoverLetterTopSection.astro";
import CoverLetterContactStrip from "@/components/cover-letter/CoverLetterContactStrip.astro";
import CoverLetterBodySection from "@/components/cover-letter/CoverLetterBodySection.astro";
import type { ResumeData } from "@/types/models";
import { currentDate } from "@/utils/date.util";

const resume = (await sanity.fetch(resumeQuery)) as ResumeData;
const params = Astro.url.searchParams;
const { pageData, meta } = buildCoverLetterPageTemplateData(
  resume,
  params,
  currentDate,
);
---

<DocumentPrintLayout>
  <article
    role="document"
    aria-label="Cover letter printable page"
    class="cover-letter-print-page mx-auto box-border flex h-[297mm] min-h-[297mm] w-full max-w-[210mm] flex-col border-0 bg-print-bg p-0 text-[93%] text-print-base shadow-none max-[900px]:h-auto max-[900px]:min-h-0 max-[900px]:border-0 print:h-[297mm] print:min-h-[297mm] print:border-0 print:p-0"
  >
    <CoverLetterTopSection
      fullName={pageData.fullName}
      role={pageData.role}
      heroImage={pageData.heroImage}
      initials={pageData.initials}
      aboutMeText={pageData.aboutMeText}
    />

    <CoverLetterContactStrip
      phoneValue={pageData.phoneValue}
      emailValue={pageData.emailValue}
      location={pageData.location}
    />

    <CoverLetterBodySection
      recipientName={pageData.recipientName}
      recipientRole={pageData.recipientRole}
      recipientCompany={pageData.recipientCompany}
      phoneValue={pageData.phoneValue}
      recipientLocation={pageData.recipientLocation}
      fullName={pageData.fullName}
      role={pageData.role}
      salutation={pageData.salutation}
      currentDate={pageData.currentDate}
      paragraphOne={pageData.paragraphOne}
      paragraphTwo={pageData.paragraphTwo}
      paragraphThree={pageData.paragraphThree}
      location={pageData.location}
    />

    <div
      id={COVER_LETTER_TEMPLATE_META_ID}
      hidden
      data-primary-skill={meta.primarySkill}
      data-secondary-skill={meta.secondarySkill}
      data-relevant-tech={meta.relevantTech}
      data-current-job-title={meta.currentJobTitle}
      data-last-company={meta.lastCompany}
      data-latest-accomplishment={meta.latestAccomplishment}
      data-default-job-title={meta.defaults.jobTitle}
      data-default-recipient-company={meta.defaults.recipientCompany}
      data-default-primary-skill={meta.defaults.primarySkill}
      data-default-secondary-skill={meta.defaults.secondarySkill}
      data-default-latest-accomplishment={meta.defaults.latestAccomplishment}
      data-paragraph-one-template={meta.paragraphTemplates.one}
      data-paragraph-two-template={meta.paragraphTemplates.two}
      data-paragraph-three-template={meta.paragraphTemplates.three}
    >
    </div>
  </article>
</DocumentPrintLayout>

<script>
  import {
    COVER_LETTER_AUTO_PRINT_FALLBACK_KEY,
    COVER_LETTER_AUTO_PRINT_LAST_TOKEN_KEY,
    COVER_LETTER_FORM_PARAM_MAPPING,
  } from "@/const";
  import {
    bindWindowEventWithPagehideCleanup,
    runOnAstroPageLoad,
  } from "@/utils/astro-page.util";
  import {
    getCoverLetterCompanyText,
    getCoverLetterRoleText,
    parseCoverLetterClientTemplatePayload,
  } from "@/utils/cover-letter.util";
  import { renderTemplate } from "@/utils/template.util";
  import {
    applyPdfPrintTitle,
    runAutoPrintIfRequested,
  } from "@/utils/print.util";

  const applyCoverLetterParams = () => {
    const params = new URLSearchParams(window.location.search);
    const hasDynamicParams =
      COVER_LETTER_FORM_PARAM_MAPPING.some((item) => {
        return Boolean(params.get(item.param)?.trim());
      }) ||
      Boolean(params.get("jobTitle")?.trim()) ||
      Boolean(params.get("relevantTech")?.trim());

    // Server-rendered content already contains defaults; skip client rewrites
    // when no URL overrides are present to prevent avoidable layout shifts.
    if (!hasDynamicParams) {
      return;
    }

    for (const item of COVER_LETTER_FORM_PARAM_MAPPING) {
      const value = params.get(item.param)?.trim();
      const target = document.getElementById(item.id);
      if (value && target) {
        target.textContent = value;
      }
    }

    const templatePayload = parseCoverLetterClientTemplatePayload();
    if (!templatePayload) {
      return;
    }

    const {
      dataset,
      paragraphElements: {
        one: paragraphOne,
        two: paragraphTwo,
        three: paragraphThree,
      },
    } = templatePayload;

    const roleText = getCoverLetterRoleText();
    const companyText = getCoverLetterCompanyText();

    const defaultJobTitle = dataset.defaultJobTitle;
    const defaultRecipientCompany = dataset.defaultRecipientCompany;
    const defaultPrimarySkill = dataset.defaultPrimarySkill;
    const defaultSecondarySkill = dataset.defaultSecondarySkill;
    const defaultLatestAccomplishment = dataset.defaultLatestAccomplishment;

    const jobTitle =
      params.get("jobTitle")?.trim() || roleText || defaultJobTitle;
    const recipientCompany = companyText || defaultRecipientCompany;
    const primarySkill = dataset.primarySkill || defaultPrimarySkill;
    const secondarySkill = dataset.secondarySkill || defaultSecondarySkill;
    const relevantTech =
      params.get("relevantTech")?.trim() ||
      dataset.relevantTech ||
      primarySkill ||
      defaultPrimarySkill;
    const currentJobTitle =
      dataset.currentJobTitle || roleText || defaultJobTitle;
    const lastCompany = dataset.lastCompany || recipientCompany;
    const latestAccomplishment =
      dataset.latestAccomplishment || defaultLatestAccomplishment;
    const paragraphOneTemplate = dataset.paragraphOneTemplate || "";
    const paragraphTwoTemplate = dataset.paragraphTwoTemplate || "";
    const paragraphThreeTemplate = dataset.paragraphThreeTemplate || "";

    if (
      !paragraphOneTemplate ||
      !paragraphTwoTemplate ||
      !paragraphThreeTemplate
    ) {
      return;
    }

    const paragraphOneText = renderTemplate(paragraphOneTemplate, {
      jobTitle,
      recipientCompany,
      primarySkill,
      secondarySkill,
    });
    const paragraphTwoText = renderTemplate(paragraphTwoTemplate, {
      currentJobTitle,
      lastCompany,
      latestAccomplishment,
      relevantTech,
    });
    const paragraphThreeText = renderTemplate(paragraphThreeTemplate, {
      recipientCompany,
    });

    paragraphOne.textContent = paragraphOneText;
    paragraphTwo.textContent = paragraphTwoText;
    paragraphThree.textContent = paragraphThreeText;
  };

  runOnAstroPageLoad(applyCoverLetterParams);

  const applyCoverLetterPrintTitle = () => {
    applyPdfPrintTitle(document, "cover-letter");
  };

  const maybeAutoPrint = async () => {
    await runAutoPrintIfRequested({
      kind: "cover-letter",
      lastTokenStorageKey: COVER_LETTER_AUTO_PRINT_LAST_TOKEN_KEY,
      fallbackStorageKey: COVER_LETTER_AUTO_PRINT_FALLBACK_KEY,
    });
  };

  bindWindowEventWithPagehideCleanup("beforeprint", applyCoverLetterPrintTitle);
  runOnAstroPageLoad(maybeAutoPrint);
</script>
