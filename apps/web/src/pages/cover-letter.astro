---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { sanity } from "@/lib/sanity";
import { resumeQuery } from "@/lib/queries";
import { getImage } from "@/utils/feature.util";
import { renderTemplate } from "@/utils/template.util";
import CoverLetterTopSection from "@/components/cover-letter/CoverLetterTopSection.astro";
import CoverLetterContactStrip from "@/components/cover-letter/CoverLetterContactStrip.astro";
import CoverLetterBodySection from "@/components/cover-letter/CoverLetterBodySection.astro";
import { getEmailContact, getPhoneContact } from "@/utils/contact.util";
import type { ResumeData } from "@/types/models";
import { currentDate } from "@/utils/date.util";

const resume = (await sanity.fetch(resumeQuery)) as ResumeData;

const profile = (resume?.profile ?? {}) as ProfileWithLegacyLocation;
const contacts = resume?.contacts ?? [];
const experiences: ExperienceLike[] = resume?.experience ?? [];
const skills = resume?.skills ?? [];

const DEFAULTS = {
  fullName: "Your Name",
  role: "UI/UX Designer",
  recipientName: "Hiring Manager",
  recipientRole: "Talent Acquisition Team",
  recipientCompany: "Company Name",
  recipientLocation: "State, Country, 12345",
  salutation: "Dear Sir,",
  jobTitle: "Software Engineer",
  primarySkill: "frontend development",
  secondarySkill: "problem-solving",
  latestAccomplishment:
    "delivered measurable improvements across product experiences",
  lastCompany: "your most recent company",
  profileLocation: "City, State, Country, 12345",
} as const;

type ProfileWithLegacyLocation = {
  name?: string;
  title?: string;
  introduction?: string;
  summary?: string[];
  image?: any;
  location?: string;
  lcaotion?: string;
};

type ExperienceLike = {
  joiningDate?: string;
  releaseDate?: string;
  designation?: string;
  company?: string;
  roles?: string[];
  desc?: string;
};

const PARAGRAPH_TEMPLATES = {
  one: "I am writing to express my strong interest in the {{jobTitle}} position at {{recipientCompany}}. With a solid background in frontend technology and a proven track record of {{primarySkill}} and {{secondarySkill}}, I am confident in my ability to make an immediate and positive impact on your team.",
  two: "In my most recent role as a {{currentJobTitle}} at {{lastCompany}}, I successfully {{latestAccomplishment}}. My experience has equipped me with a deep understanding of {{relevantTech}}, which aligns perfectly with the requirements of this role.",
  three:
    "I would welcome the opportunity to discuss how my background, skills, and certifications can contribute to the continued success of {{recipientCompany}}. Thank you for considering my application. I have attached my resume for your review and look forward to the possibility of an interview.",
} as const;

const fullName = (profile?.name ?? DEFAULTS.fullName).trim();
const role = profile?.title ?? DEFAULTS.role;
const initials =
  fullName
    .split(" ")
    .filter(Boolean)
    .map((part) => part[0]?.toUpperCase() ?? "")
    .slice(0, 2)
    .join("") || "YN";

const heroImage = profile?.image ? getImage(profile.image, 560, 560) : "";
const phoneContact = getPhoneContact(contacts);
const emailContact = getEmailContact(contacts);

const params = Astro.url.searchParams;

const getParam = (key: string, fallback: string) => {
  const value = params.get(key)?.trim();
  return value ? value : fallback;
};

const toSortableTime = (value?: string) => {
  if (!value) return 0;
  const parsed = Date.parse(value);
  return Number.isNaN(parsed) ? 0 : parsed;
};

const getLatestExperience = (items: ExperienceLike[]) => {
  return items.reduce<ExperienceLike | undefined>((latest, item) => {
    if (!latest) return item;
    const latestTime = toSortableTime(
      latest?.releaseDate || latest?.joiningDate,
    );
    const itemTime = toSortableTime(item?.releaseDate || item?.joiningDate);
    return itemTime > latestTime ? item : latest;
  }, undefined);
};

const latestExperience = getLatestExperience(experiences);

const currentJobTitle = latestExperience?.designation || role;
const lastCompany = latestExperience?.company || DEFAULTS.lastCompany;
const primarySkill = skills[0]?.name || DEFAULTS.primarySkill;
const secondarySkill = skills[1]?.name || DEFAULTS.secondarySkill;
const latestAccomplishment =
  latestExperience?.roles?.[0] ||
  latestExperience?.desc ||
  DEFAULTS.latestAccomplishment;

const recipientName = getParam("to", DEFAULTS.recipientName);
const recipientRole = getParam("role", DEFAULTS.recipientRole);
const recipientCompany = getParam(
  "company",
  latestExperience?.company || DEFAULTS.recipientCompany,
);
const recipientLocation = getParam("location", DEFAULTS.recipientLocation);
const salutation = getParam("greeting", DEFAULTS.salutation);
const jobTitle = getParam("jobTitle", recipientRole || DEFAULTS.jobTitle);
const relevantTech = getParam("relevantTech", primarySkill);

const introSummary = profile?.introduction || "";
const summaryText = Array.isArray(profile?.summary)
  ? profile.summary.join(" ")
  : "";

const mergedBio = `${introSummary} ${summaryText}`.trim();

const clipText = (value: string, maxLength: number) => {
  if (!value) return "";
  if (value.length <= maxLength) return value;
  return `${value.slice(0, maxLength).trimEnd()}...`;
};

const aboutMeText = clipText(mergedBio, 340);

// Backward-compatible fallback for legacy typo in stored profile data.
const profileLocation =
  profile?.location || profile?.lcaotion || DEFAULTS.profileLocation;

const paragraphOne = renderTemplate(PARAGRAPH_TEMPLATES.one, {
  jobTitle,
  recipientCompany,
  primarySkill,
  secondarySkill,
});
const paragraphTwo = renderTemplate(PARAGRAPH_TEMPLATES.two, {
  currentJobTitle,
  lastCompany,
  latestAccomplishment,
  relevantTech,
});
const paragraphThree = renderTemplate(PARAGRAPH_TEMPLATES.three, {
  recipientCompany,
});
---

<BaseLayout>
  <div
    class="min-h-0 bg-print-bg py-0 font-sans text-print-base [--mono-ink:var(--print-ink)] [--mono-strong:var(--print-strong)] [--mono-base:var(--print-base)] [--mono-muted:var(--print-muted)] [--mono-subtle:var(--print-subtle)] [--print-primary-rgb:185_218_63] max-[900px]:bg-[linear-gradient(180deg,rgba(var(--print-primary-rgb),0.18)_0%,rgba(var(--print-primary-rgb),0.05)_18%,#fff_52%)]"
  >
    <div
      class="fixed right-3.5 top-3.5 z-20 flex items-center gap-2 print:hidden"
    >
      <a
        href="/resume"
        class="inline-flex items-center justify-center rounded-full border border-print-border bg-print-bg px-3 py-1.5 text-[0.82rem] font-semibold text-print-ink shadow-[0_4px_14px_rgba(17,24,39,0.12)]"
      >
        Resume
      </a>
      <button
        id="cover-letter-print-btn"
        class="cursor-pointer rounded-full border border-print-border bg-print-primary px-3.5 py-1.5 text-[0.85rem] font-semibold text-print-ink shadow-[0_4px_14px_rgba(17,24,39,0.18)]"
        type="button"
      >
        Print Cover Letter
      </button>
    </div>

    <article
      class="cover-letter-print-page mx-auto box-border flex h-[297mm] min-h-[297mm] w-full max-w-[210mm] flex-col border-0 bg-print-bg p-0 text-[93%] text-print-base shadow-none max-[900px]:h-auto max-[900px]:min-h-0 max-[900px]:border-0 print:h-auto print:min-h-0 print:border-0 print:p-0"
    >
      <CoverLetterTopSection
        fullName={fullName}
        role={role}
        heroImage={heroImage}
        initials={initials}
        aboutMeText={aboutMeText}
      />

      <CoverLetterContactStrip
        phoneValue={phoneContact?.value || "+000 0000 0000"}
        emailValue={emailContact?.value || "www.example.com"}
        location={profileLocation}
      />

      <CoverLetterBodySection
        recipientName={recipientName}
        recipientRole={recipientRole}
        recipientCompany={recipientCompany}
        phoneValue={phoneContact?.value || "+00 1234 5678 9000"}
        recipientLocation={recipientLocation}
        fullName={fullName}
        role={role}
        salutation={salutation}
        currentDate={currentDate}
        paragraphOne={paragraphOne}
        paragraphTwo={paragraphTwo}
        paragraphThree={paragraphThree}
        location={profileLocation}
      />

      <div
        id="cl-template-meta"
        hidden
        data-primary-skill={primarySkill}
        data-secondary-skill={secondarySkill}
        data-relevant-tech={relevantTech}
        data-current-job-title={currentJobTitle}
        data-last-company={lastCompany}
        data-latest-accomplishment={latestAccomplishment}
        data-paragraph-one-template={PARAGRAPH_TEMPLATES.one}
        data-paragraph-two-template={PARAGRAPH_TEMPLATES.two}
        data-paragraph-three-template={PARAGRAPH_TEMPLATES.three}
      >
      </div>
    </article>
  </div>
</BaseLayout>

<style is:global>
  @import "@/styles/print-template.css";
</style>

<script>
  import { renderTemplate } from "@/utils/template.util";

  const DEFAULTS = {
    jobTitle: "Software Engineer",
    recipientCompany: "Company Name",
    primarySkill: "frontend development",
    secondarySkill: "problem-solving",
    latestAccomplishment:
      "delivered measurable improvements across product experiences",
    paragraphOneTemplate:
      "I am writing to express my strong interest in the {{jobTitle}} position at {{recipientCompany}}. With a solid background in frontend technology and a proven track record of {{primarySkill}} and {{secondarySkill}}, I am confident in my ability to make an immediate and positive impact on your team.",
    paragraphTwoTemplate:
      "In my most recent role as a {{currentJobTitle}} at {{lastCompany}}, I successfully {{latestAccomplishment}}. My experience has equipped me with a deep understanding of {{relevantTech}}, which aligns perfectly with the requirements of this role.",
    paragraphThreeTemplate:
      "I would welcome the opportunity to discuss how my background, skills, and certifications can contribute to the continued success of {{recipientCompany}}. Thank you for considering my application. I have attached my resume for your review and look forward to the possibility of an interview.",
  };

  const applyCoverLetterParams = () => {
    const params = new URLSearchParams(window.location.search);
    const mapping = [
      { param: "to", id: "cl-to" },
      { param: "role", id: "cl-to-role" },
      { param: "company", id: "cl-company" },
      { param: "location", id: "cl-recipient-location-to" },
      { param: "greeting", id: "cl-salutation" },
    ];

    for (const item of mapping) {
      const value = params.get(item.param)?.trim();
      const target = document.getElementById(item.id);
      if (value && target) {
        target.textContent = value;
      }
    }

    const meta = document.getElementById("cl-template-meta");
    const paragraphOne = document.getElementById("cl-paragraph-1");
    const paragraphTwo = document.getElementById("cl-paragraph-2");
    const paragraphThree = document.getElementById("cl-paragraph-3");

    if (!meta || !paragraphOne || !paragraphTwo || !paragraphThree) {
      return;
    }

    const dataset = meta.dataset;
    const roleText = document.getElementById("cl-to-role")?.textContent?.trim();
    const companyText = document
      .getElementById("cl-company")
      ?.textContent?.trim();

    const jobTitle =
      params.get("jobTitle")?.trim() || roleText || DEFAULTS.jobTitle;
    const recipientCompany = companyText || DEFAULTS.recipientCompany;
    const primarySkill = dataset.primarySkill || DEFAULTS.primarySkill;
    const secondarySkill = dataset.secondarySkill || DEFAULTS.secondarySkill;
    const relevantTech =
      params.get("relevantTech")?.trim() ||
      dataset.relevantTech ||
      primarySkill ||
      DEFAULTS.primarySkill;
    const currentJobTitle =
      dataset.currentJobTitle || roleText || DEFAULTS.jobTitle;
    const lastCompany = dataset.lastCompany || recipientCompany;
    const latestAccomplishment =
      dataset.latestAccomplishment || DEFAULTS.latestAccomplishment;
    const paragraphOneTemplate =
      dataset.paragraphOneTemplate || DEFAULTS.paragraphOneTemplate;
    const paragraphTwoTemplate =
      dataset.paragraphTwoTemplate || DEFAULTS.paragraphTwoTemplate;
    const paragraphThreeTemplate =
      dataset.paragraphThreeTemplate || DEFAULTS.paragraphThreeTemplate;

    const paragraphOneText = renderTemplate(paragraphOneTemplate, {
      jobTitle,
      recipientCompany,
      primarySkill,
      secondarySkill,
    });
    const paragraphTwoText = renderTemplate(paragraphTwoTemplate, {
      currentJobTitle,
      lastCompany,
      latestAccomplishment,
      relevantTech,
    });
    const paragraphThreeText = renderTemplate(paragraphThreeTemplate, {
      recipientCompany,
    });

    paragraphOne.textContent = paragraphOneText;
    paragraphTwo.textContent = paragraphTwoText;
    paragraphThree.textContent = paragraphThreeText;
  };

  applyCoverLetterParams();
  document.addEventListener("astro:page-load", applyCoverLetterParams);

  const getPrintDate = () => {
    const now = new Date();
    const yyyy = now.getFullYear();
    const mm = String(now.getMonth() + 1).padStart(2, "0");
    const dd = String(now.getDate()).padStart(2, "0");
    return `${yyyy}-${mm}-${dd}`;
  };

  const applyCoverLetterPrintTitle = () => {
    document.title = `cover-letter_sk-masum_${getPrintDate()}`;
  };

  const bindCoverLetterPrintButton = () => {
    const button = document.getElementById("cover-letter-print-btn");
    if (!button || button.dataset.printBound === "true") {
      return;
    }

    button.dataset.printBound = "true";
    button.addEventListener("click", () => {
      applyCoverLetterPrintTitle();
      window.print();
    });
  };

  window.addEventListener("beforeprint", applyCoverLetterPrintTitle);
  bindCoverLetterPrintButton();
  document.addEventListener("astro:page-load", bindCoverLetterPrintButton);
</script>
