---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { sanity } from "@/lib/sanity";
import { resumeQuery } from "@/lib/queries";
import { getImage } from "@/utils/feature.util";
import { currentDate, formatDateRange } from "@/utils/date.util";
import { calculateTotalTenure } from "@/utils";
import { getHeaderContacts, getWebsiteContact } from "@/utils/contact.util";
import Modal from "@/components/ui/Modal.astro";
import CoverLetterForm from "@/components/modals/CoverLetterForm.astro";
import TopSection from "@/components/print-template/TopSection.astro";
import MainDetailsSection from "@/components/print-template/MainDetailsSection.astro";
import AdditionalDetailsSection from "@/components/print-template/AdditionalDetailsSection.astro";
import type {
  ResumeData,
  ResumeEducationList,
  ResumeExperience,
  ResumeExperienceList,
  ResumeHobbies,
  ResumeProjects,
  ResumeSkills,
  ResumeTools,
} from "@/types/models";
import type { ExperienceItem, ProjectItem } from "@/types/features";

const resume = (await sanity.fetch(resumeQuery)) as ResumeData;

const profile = resume?.profile ?? {};
const contacts = (resume?.contacts ?? []).slice(0, 3);
const skills: ResumeSkills = (resume?.skills ?? []).slice(0, 7);
const experience: ResumeExperienceList = (resume?.experience ?? []).slice(0, 3);
const education: ResumeEducationList = (resume?.education ?? []).slice(0, 3);
const projects: ResumeProjects = resume?.projects ?? [];
const tools: ResumeTools = resume?.tools ?? [];
const hobbies: ResumeHobbies = resume?.hobbies ?? [];

const name = (profile?.name ?? "Your Name").trim();
const nameParts = name.split(" ").filter(Boolean);
const firstName = nameParts[0] ?? "Your";
const lastName = nameParts.slice(1).join(" ") || "Name";

const heroImage = profile?.image ? getImage(profile.image, 560, 760) : "";
const profileText =
  profile?.introduction ||
  (Array.isArray(profile?.summary) ? profile.summary.join(" ") : "");

const clipText = (value: string, maxLength: number) => {
  if (!value) return "";
  if (value.length <= maxLength) return value;
  return `${value.slice(0, maxLength).trimEnd()}...`;
};

const profileSummary = clipText(profileText, 300);
const headerContacts = getHeaderContacts(contacts);
const websiteContact = getWebsiteContact(resume?.contacts ?? []);

const roleLine = profile?.title ? profile.title : "Software Engineer";
const { years: totalExperienceYears, months: totalExperienceMonths } =
  calculateTotalTenure(resume?.experience ?? []);
const roPlaceholder = "Hiring Manager";
const rolePlaceholder = "Talent Acquisition Team";
const companyPlaceholder = experience[0]?.company || "Company Name";
const locationPlaceholder = websiteContact?.value || "State, Country, 12345";
const salutationPlaceholder = "Dear Sir,";
const jobTitlePlaceholder = roleLine;
const relevantTechPlaceholder =
  skills[0]?.name || tools[0]?.name || "React, TypeScript";

const experienceItems: ExperienceItem[] = experience.map(
  (item: ResumeExperience) => ({
    dateRange: formatDateRange(
      item?.joiningDate || "2020-01",
      item?.releaseDate || "",
    ),
    designation: item?.designation,
    company: item?.company,
    shortDesc: item?.desc ? clipText(item.desc, 230) : "",
    shortRoles: Array.isArray(item?.roles) ? item.roles.slice(0, 2) : [],
    joiningDate: item?.joiningDate,
    releaseDate: item?.releaseDate,
  }),
);

const projectItems: ProjectItem[] = projects.slice(0, 6).map((item) => ({
  title: item?.title,
  shortDescription: item?.description ? clipText(item.description, 220) : "",
  techText:
    Array.isArray(item?.techStacks) && item.techStacks.length > 0
      ? item.techStacks.slice(0, 6).join(", ")
      : "",
}));
---

<BaseLayout>
  <div
    class="min-h-0 bg-print-bg py-0 font-sans text-print-base [--mono-ink:var(--print-ink)] [--mono-strong:var(--print-strong)] [--mono-base:var(--print-base)] [--mono-muted:var(--print-muted)] [--mono-subtle:var(--print-subtle)] [--print-primary-rgb:185_218_63] max-[900px]:bg-[linear-gradient(180deg,rgba(var(--print-primary-rgb),0.18)_0%,rgba(var(--print-primary-rgb),0.05)_18%,#fff_52%)]"
  >
    <div
      class="fixed right-3.5 top-3.5 z-20 flex items-center gap-2 print:hidden"
    >
      <Modal id="cover-letter-form" type="sheet">
        <span
          slot="trigger"
          class="inline-flex items-center justify-center rounded-full border border-[#111111] bg-white px-3 py-1.5 text-[0.82rem] font-semibold text-[#111111] shadow-[0_4px_14px_rgba(17,24,39,0.12)]"
        >
          Cover Letter
        </span>
        <CoverLetterForm
          slot="content"
          roPlaceholder={roPlaceholder}
          rolePlaceholder={rolePlaceholder}
          companyPlaceholder={companyPlaceholder}
          locationPlaceholder={locationPlaceholder}
          salutationPlaceholder={salutationPlaceholder}
          jobTitlePlaceholder={jobTitlePlaceholder}
          relevantTechPlaceholder={relevantTechPlaceholder}
        />
      </Modal>
      <button
        class="cursor-pointer rounded-full border border-[#111111] bg-print-primary px-3.5 py-1.5 text-[0.85rem] font-semibold text-[#111111] shadow-[0_4px_14px_rgba(17,24,39,0.18)]"
        type="button"
        onclick="window.print()"
      >
        Print This Page
      </button>
    </div>

    <article
      class="mx-auto box-border min-h-0 w-full max-w-[194mm] rounded-none border-0 bg-print-bg p-[5.2mm_4.6mm] text-[93%] text-print-base shadow-none max-[900px]:border max-[900px]:border-print-primary/60 print:border-0"
    >
      <TopSection
        firstName={firstName}
        lastName={lastName}
        headerContacts={headerContacts}
        heroImage={heroImage}
        fullName={name}
        roleLine={roleLine}
        totalExperienceYears={totalExperienceYears}
        totalExperienceMonths={totalExperienceMonths}
        profileSummary={profileSummary ||
          "Add your introduction in the profile section."}
      />

      <MainDetailsSection education={education} experience={experienceItems} />
    </article>

    <article
      class="relative mx-auto mt-0 box-border min-h-[calc(297mm-16mm)] w-full max-w-[194mm] break-before-auto rounded-none border-0 bg-print-bg p-[5.2mm_4.6mm] pb-[12mm] text-[93%] text-print-base shadow-none max-[900px]:border max-[900px]:border-print-primary/60 print:border-0 print:break-before-page"
    >
      <AdditionalDetailsSection
        projects={projectItems}
        tools={tools}
        hobbies={hobbies}
        skills={skills}
      />
      <p
        class="absolute bottom-[5.2mm] right-[4.6mm] m-0 text-right text-[3.2mm] tracking-[0.02em] text-print-muted"
      >
        Last updated on: {currentDate}
      </p>
    </article>
  </div>
</BaseLayout>

<style is:global>
  @import "@/styles/print-template.css";
</style>
