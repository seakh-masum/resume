---
import DocumentPrintLayout from "@/layouts/DocumentPrintLayout.astro";
import { sanity } from "@/lib/sanity";
import { resumeQuery } from "@/lib/queries";
import { buildResumePageTemplateData } from "@/lib/template-data";
import { currentDate } from "@/utils/date.util";
import TopSection from "@/components/resume/TopSection.astro";
import MainDetailsSection from "@/components/resume/MainDetailsSection.astro";
import AdditionalDetailsSection from "@/components/resume/AdditionalDetailsSection.astro";
import type { ResumeData } from "@/types/models";

const resume = (await sanity.fetch(resumeQuery)) as ResumeData;
const pageData = buildResumePageTemplateData(resume, currentDate);
---

<DocumentPrintLayout>
  <article
    role="document"
    aria-label="Resume printable page one"
    class="resume-print-page resume-print-page--first mx-auto box-border min-h-0 w-full max-w-[194mm] rounded-none border-0 bg-print-bg p-[5.2mm_4.6mm] text-[93%] text-print-base shadow-none max-[900px]:border max-[900px]:border-print-primary/60 print:border-0"
  >
    <TopSection
      firstName={pageData.firstName}
      lastName={pageData.lastName}
      headerContacts={pageData.headerContacts}
      heroImage={pageData.heroImage}
      fullName={pageData.fullName}
      roleLine={pageData.roleLine}
      totalExperienceYears={pageData.totalExperienceYears}
      totalExperienceMonths={pageData.totalExperienceMonths}
      profileSummary={pageData.profileSummary ||
        "Add your introduction in the profile section."}
    />

    <MainDetailsSection
      education={pageData.education}
      experience={pageData.experience}
    />
  </article>

  <article
    role="document"
    aria-label="Resume printable page two"
    class="resume-print-page resume-print-page--second relative mx-auto mt-0 box-border min-h-[calc(297mm-16mm)] w-full max-w-[194mm] break-before-auto rounded-none border-0 bg-print-bg p-[5.2mm_4.6mm] pb-[12mm] text-[93%] text-print-base shadow-none max-[900px]:border max-[900px]:border-print-primary/60 print:min-h-0 print:border-0 print:break-before-page"
  >
    <AdditionalDetailsSection
      projects={pageData.projects}
      tools={pageData.tools}
      certifications={pageData.certifications}
      hobbies={pageData.hobbies}
      skills={pageData.skills}
    />
    <p
      class="resume-print-updated-at absolute bottom-[5.2mm] right-[4.6mm] m-0 text-right text-[3.2mm] tracking-[0.02em] text-print-muted print:static print:mt-[4mm]"
    >
      Last updated on: {pageData.currentDate}
    </p>
  </article>
</DocumentPrintLayout>

<script>
  import {
    RESUME_AUTO_PRINT_FALLBACK_KEY,
    RESUME_AUTO_PRINT_LAST_TOKEN_KEY,
  } from "@/const";
  import {
    bindWindowEventWithPagehideCleanup,
    runOnAstroPageLoad,
  } from "@/utils/astro-page.util";
  import {
    applyPdfPrintTitle,
    runAutoPrintIfRequested,
  } from "@/utils/print.util";

  const applyResumePrintTitle = () => {
    applyPdfPrintTitle(document, "resume");
  };

  const maybeAutoPrint = async () => {
    await runAutoPrintIfRequested({
      kind: "resume",
      lastTokenStorageKey: RESUME_AUTO_PRINT_LAST_TOKEN_KEY,
      fallbackStorageKey: RESUME_AUTO_PRINT_FALLBACK_KEY,
    });
  };

  bindWindowEventWithPagehideCleanup("beforeprint", applyResumePrintTitle);
  runOnAstroPageLoad(maybeAutoPrint);
</script>
